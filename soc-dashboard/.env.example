# ---- Wazuh (cote PC qui heberge le manager) ----
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=a-remplacer
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=a-remplacer
# 0 = accepte le certificat auto-signe du lab, 1 = verifie le certificat
WAZUH_VERIFY_TLS=0
SOC_ALERT_WINDOW_HOURS=24
# Etat de la pile : conteneurs Docker vus depuis WSL2 (best effort)
SOC_STACK_PROBE=1
WAZUH_WSL_DISTRO=wazuh
WAZUH_MANAGER_CONTAINER=single-node-wazuh.manager-1

# ---- Tableau de bord ----
SOC_DASHBOARD_URL=http://127.0.0.1:8765
SOC_BIND=127.0.0.1
SOC_PORT=8765
# Jeton partage par le collecteur et le tableau de bord (python -c "import secrets;print(secrets.token_urlsafe(32))")
SOC_INGEST_TOKEN=
# Jeton de lecture optionnel : si rempli, /api/* exige l'en-tete X-SOC-Token
SOC_READ_TOKEN=
SOC_SUMMARY_TTL=600

# ---- Bilan ----
# auto = LLM si une cle est presente, sinon moteur de regles ; regles = jamais d'appel LLM
SOC_SUMMARY_ENGINE=auto
SOC_LLM_API_KEY=
SOC_LLM_BASE_URL=https://api.deepseek.com/v1
SOC_LLM_MODEL=deepseek-chat

# ---- Notifications Telegram ----
SOC_NOTIFY=1
SOC_TELEGRAM_TOKEN=
SOC_TELEGRAM_CHAT_ID=
SOC_NOTIFY_COOLDOWN=900
SOC_PUBLIC_URL=
# Duree de validite d une demande d autorisation (secondes), refus au-dela
SOC_APPROVAL_TTL=300
